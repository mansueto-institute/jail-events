{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug - Debug Mode",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/jail-events/main.py",
            "args": ["--mode", "debug"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/src/jail-events",
            "env": {},
            "justMyCode": false
        },
        {
            "name": "Debug Pytest test_clean_database.py",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "src/jail-events/tests/test_clean_database.py"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false
        }
    ]
}